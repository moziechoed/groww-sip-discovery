# Copy this file to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here

# Needed from P2 (Reddit) and P4 (YouTube)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=groww-sip-discovery/0.1 by your-reddit-username
YOUTUBE_API_KEY=your-youtube-data-api-key

# Salt for hashing usernames at collection (FR1.4). Any long random string; keep it stable across runs.
AUTHOR_HASH_SALT=your-random-salt-here
